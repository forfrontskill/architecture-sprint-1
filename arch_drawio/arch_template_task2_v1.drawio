        <mxCell id="BfaGi0TInTkCwpDHoWxU-213" value="Добавление товара" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="BfaGi0TInTkCwpDHoWxU-212">
