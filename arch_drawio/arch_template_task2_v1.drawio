        <mxCell id="BfaGi0TInTkCwpDHoWxU-211" value="Получение информации о товаре" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="BfaGi0TInTkCwpDHoWxU-210">
          <mxGeometry x="0.8338" y="-2" relative="1" as="geometry">
            <mxPoint as="offset" />
